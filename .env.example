# Local development defaults. Sites injects the real Cloudflare D1 DB binding at deploy time.
NODE_ENV=development

# Admin access: comma-separated ChatGPT user IDs allowed to view /admin in production.
DESHIJAAT_ADMIN_USER_IDS=

# Optional PostgreSQL/Supabase production handoff (see prisma/ and DEPLOYMENT.md).
DATABASE_URL=
DIRECT_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=

# Optional Stripe-ready adapter settings. Leave empty until credentials and webhooks are configured.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
