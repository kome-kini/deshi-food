# Local development defaults. Sites injects the real Cloudflare D1 DB binding at deploy time.
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only mode switch. Set true only for the disposable Sites/demo path.
# Production/staging Postgres must set this to false.
DEMO_MODE=true

# Admin access: comma-separated ChatGPT user IDs allowed to view /admin in production.
DESHIJAAT_ADMIN_USER_IDS=

# Optional PostgreSQL/Supabase production handoff (see prisma/ and DEPLOYMENT.md).
DATABASE_URL=
DIRECT_URL=
SESSION_COOKIE_SECRET=
TOKEN_HASH_SECRET=
FIELD_ENCRYPTION_KEY=
ANALYTICS_HASH_SALT=
CRON_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=

# Optional Stripe-ready adapter settings. Leave empty until credentials and webhooks are configured.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_MODE=test

# Storage and messaging (server-only values).
MEDIA_BUCKET=
EVIDENCE_BUCKET=
STORAGE_SIGNING_SECRET=
EMAIL_PROVIDER_API_KEY=
SMS_PROVIDER_API_KEY=
PUSH_PROVIDER_KEY=
