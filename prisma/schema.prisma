  releasedAt                   DateTime?              @map("released_at") @db.Timestamptz(6)
  createdAt                    DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  variant                      ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Restrict)
  supplier                     Supplier?              @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  producer                     Producer?              @relation(fields: [producerId], references: [id], onDelete: SetNull)
  processor                    Processor?             @relation(fields: [processorId], references: [id], onDelete: SetNull)
  facility                     Facility?              @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  sourceLocation               SourceLocation?        @relation(fields: [sourceLocationId], references: [id], onDelete: SetNull)
