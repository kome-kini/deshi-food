model InventoryBatch {
  id                           String                 @id @default(uuid()) @db.Uuid
  variantId                    String                 @map("variant_id") @db.Uuid
  supplierId                   String?                @map("supplier_id") @db.Uuid
  producerId                   String?                @map("producer_id") @db.Uuid
  processorId                  String?                @map("processor_id") @db.Uuid
  facilityId                   String?                @map("facility_id") @db.Uuid
  sourceLocationId             String?                @map("source_location_id") @db.Uuid
  batchCode                    String                 @unique @map("batch_code") @db.VarChar(64)
  publicTraceTokenHash         String                 @unique @map("public_trace_token_hash") @db.Char(64)
  status                       BatchStatus            @default(PLANNED)
  originVerificationStatus     VerificationStatus     @default(PENDING) @map("origin_verification_status")
