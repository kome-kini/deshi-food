// DESHIJAAT production PostgreSQL data model.
// Monetary amounts are always stored as integer minor units (poisha) in BDT.
// Quantities use Decimal because food inventory may be measured by weight/volume.
// Generated/demo records must keep evidence-backed claims separate from marketing copy.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AccountStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DELETED
}

enum RoleScope {
  CUSTOMER
  OPERATIONS
  ADMIN
  SUPER_ADMIN
}

enum AddressType {
  HOME
  WORK
  OTHER
}

enum RecordStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum VerificationStatus {
  PENDING
  IN_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
}

enum ClaimRiskLevel {
  LOW
  MEDIUM
  HIGH
  PROHIBITED
}

enum ClaimStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
}

enum EvidenceKind {
  SUPPLIER_DOCUMENT
  ORIGIN_DOCUMENT
  PROCESSING_RECORD
  LAB_REPORT
  CERTIFICATION
  LABEL_ARTWORK
  PHOTO
  OTHER
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum PriceType {
  REGULAR
  SALE
  SUBSCRIPTION
  WHOLESALE
}

enum BatchStatus {
  PLANNED
  RECEIVED
  RELEASED
  ON_HOLD
  QUARANTINED
  EXPIRED
  RECALLED
  DEPLETED
}

enum InventoryMovementType {
  RECEIPT
  RESERVATION
  RELEASE
  SALE
  RETURN
  TRANSFER
  ADJUSTMENT
  DAMAGE
  HOLD
  UNHOLD
  EXPIRY
  RECALL
}

enum ReservationStatus {
  ACTIVE
  CONVERTED
  RELEASED
  EXPIRED
}

enum HoldStatus {
  ACTIVE
  RELEASED
  ESCALATED_TO_RECALL
}

enum RecallStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum CartStatus {
  ACTIVE
  CHECKOUT_STARTED
  CONVERTED
  ABANDONED
  EXPIRED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
  RETURNED
}

enum PaymentProvider {
  COD
  STRIPE
  BKASH
  NAGAD
  ROCKET
  BANK_CARD
}

enum PaymentStatus {
  REQUIRES_ACTION
  AUTHORIZED
  CAPTURED
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
  CANCELLED
}

enum FulfillmentStatus {
  PENDING
  PACKED
  SHIPPED
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
}

enum ReturnStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  RECEIVED
  RESOLVED
}

enum RefundStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_DELIVERY
  BUNDLE_PRICE
}

enum PromotionStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  ENDED
}

enum CouponStatus {
  ACTIVE
  PAUSED
  EXPIRED
}

enum DiscountTarget {
  ORDER
  DELIVERY
  ITEM
  BUNDLE
}

enum MarketingChannel {
  DIRECT
  ORGANIC_SEARCH
  PAID_SEARCH
  FACEBOOK
  INSTAGRAM
  TIKTOK
  YOUTUBE
  EMAIL
  SMS
  PUSH
  AFFILIATE
  MARKETPLACE
  OTHER
}

enum ConsentStatus {
  OPTED_IN
  OPTED_OUT
  NOT_SET
}

enum MessageChannel {
  EMAIL
  SMS
  PUSH
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  FAILED
  UNSUBSCRIBED
}

enum AttributionModel {
  FIRST_TOUCH
  LAST_TOUCH
  LINEAR
  POSITION_BASED
  DATA_DRIVEN
}

enum MetricPeriod {
  DAY
  WEEK
  MONTH
}

enum RecommendationType {
  PROMOTE_PRODUCT
  CREATE_BUNDLE
  REDUCE_DISCOUNT
  INCREASE_DISCOUNT
  RESTOCK
  TRANSFER_STOCK
  MARKDOWN_EXPIRING_STOCK
}

enum RecommendationStatus {
  OPEN
  ACCEPTED
  DISMISSED
  EXECUTED
  EXPIRED
}

enum ExperimentStatus {
  DRAFT
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

enum ExperimentUnit {
  USER
  SESSION
  CART
}

enum WebhookStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  APPROVE
  REJECT
  HOLD
  RECALL
  REFUND
}

enum DataQualitySeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum DataQualityStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  WAIVED
}

model User {
  id                          String                  @id @default(uuid()) @db.Uuid
  email                       String                  @unique @db.Citext
  phoneE164                   String?                 @unique @map("phone_e164") @db.VarChar(20)
  displayName                 String?                 @map("display_name") @db.VarChar(160)
  preferredLocale             String                  @default("bn-BD") @map("preferred_locale") @db.VarChar(12)
  status                      AccountStatus           @default(ACTIVE)
  emailVerifiedAt             DateTime?               @map("email_verified_at") @db.Timestamptz(6)
  phoneVerifiedAt             DateTime?               @map("phone_verified_at") @db.Timestamptz(6)
  lastLoginAt                 DateTime?               @map("last_login_at") @db.Timestamptz(6)
  createdAt                   DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                   DateTime?               @map("deleted_at") @db.Timestamptz(6)
  identities                  UserIdentity[]
  sessions                    AuthSession[]
  roles                       UserRole[]              @relation("RoleSubject")
  roleGrants                  UserRole[]              @relation("RoleGrantor")
  customerProfile             CustomerProfile?
  addresses                   Address[]
  carts                       Cart[]
  wishlists                   Wishlist[]
  orders                      Order[]
  reviews                     ProductReview[]
  questions                   ProductQuestion[]
  answers                     ProductAnswer[]
  marketingConsents           MarketingConsent[]
  marketingTouchpoints        MarketingTouchpoint[]
  messageDeliveries           MessageDelivery[]
  audienceMemberships         AudienceMembership[]
  retargetingMemberships      RetargetingListMember[]
  recoveryAttempts            RecoveryAttempt[]
  analyticsSessions           AnalyticsSession[]
  analyticsEvents             AnalyticsEvent[]
  rfmSnapshots                CustomerRfmSnapshot[]
  cohortMemberships           CohortMember[]
  experimentAssignments       ExperimentAssignment[]
  supplierVerificationReviews SupplierVerification[]  @relation("SupplierVerificationReviewer")
  productClaimReviews         ProductClaim[]          @relation("ProductClaimReviewer")
  inventoryHoldsCreated       InventoryHold[]         @relation("InventoryHoldCreator")
  couponRedemptions           CouponRedemption[]
  auditLogs                   AuditLog[]              @relation("AuditActor")

  @@index([status, createdAt])
  @@map("users")
}

model UserIdentity {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  provider        String   @db.VarChar(40)
  providerSubject String   @map("provider_subject") @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt      DateTime @default(now()) @map("last_used_at") @db.Timestamptz(6)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("user_identities")
}

model AuthSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  ipHash    String?   @map("ip_hash") @db.Char(64)
  userAgent String?   @map("user_agent") @db.VarChar(512)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("auth_sessions")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique @db.VarChar(64)
  name        String           @db.VarChar(120)
  description String?
  scope       RoleScope
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  userRoles   UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique @db.VarChar(100)
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId    String    @map("user_id") @db.Uuid
  roleId    String    @map("role_id") @db.Uuid
  grantedBy String?   @map("granted_by") @db.Uuid
  grantedAt DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)
  user      User      @relation("RoleSubject", fields: [userId], references: [id], onDelete: Cascade)
  grantor   User?     @relation("RoleGrantor", fields: [grantedBy], references: [id], onDelete: SetNull)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model CustomerProfile {
  id                       String    @id @default(uuid()) @db.Uuid
  userId                   String    @unique @map("user_id") @db.Uuid
  customerNumber           String    @unique @map("customer_number") @db.VarChar(32)
  firstOrderAt             DateTime? @map("first_order_at") @db.Timestamptz(6)
  lastOrderAt              DateTime? @map("last_order_at") @db.Timestamptz(6)
  totalOrders              Int       @default(0) @map("total_orders")
  lifetimeRevenueMinor     BigInt    @default(0) @map("lifetime_revenue_minor")
  lifetimeGrossProfitMinor BigInt    @default(0) @map("lifetime_gross_profit_minor")
  acquisitionCostMinor     BigInt    @default(0) @map("acquisition_cost_minor")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lastOrderAt])
  @@map("customer_profiles")
}

model Address {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  type          AddressType @default(HOME)
  recipientName String      @map("recipient_name") @db.VarChar(160)
  phoneE164     String      @map("phone_e164") @db.VarChar(20)
  line1         String      @db.VarChar(255)
  line2         String?     @db.VarChar(255)
  area          String?     @db.VarChar(120)
  city          String      @db.VarChar(120)
  district      String      @db.VarChar(120)
  division      String      @db.VarChar(120)
  postalCode    String?     @map("postal_code") @db.VarChar(20)
  countryCode   String      @default("BD") @map("country_code") @db.Char(2)
  deliveryNotes String?     @map("delivery_notes") @db.VarChar(500)
  isDefault     Boolean     @default(false) @map("is_default")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isDefault])
  @@map("addresses")
}

model Category {
  id          String              @id @default(uuid()) @db.Uuid
  parentId    String?             @map("parent_id") @db.Uuid
  slug        String              @unique @db.VarChar(160)
  nameBn      String              @map("name_bn") @db.VarChar(180)
  nameEn      String              @map("name_en") @db.VarChar(180)
  description String?
  sortOrder   Int                 @default(0) @map("sort_order")
  status      RecordStatus        @default(DRAFT)
  parent      Category?           @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[]          @relation("CategoryTree")
  products    Product[]
  promotions  PromotionCategory[]

  @@index([parentId, sortOrder])
  @@map("categories")
}

model Producer {
  id                 String             @id @default(uuid()) @db.Uuid
  code               String             @unique @db.VarChar(32)
  name               String             @db.VarChar(200)
  storyBn            String?            @map("story_bn")
  storyEn            String?            @map("story_en")
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  status             RecordStatus       @default(DRAFT)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  products           Product[]
  batches            InventoryBatch[]

  @@index([verificationStatus, status])
  @@map("producers")
}

model Supplier {
  id                 String                 @id @default(uuid()) @db.Uuid
  code               String                 @unique @db.VarChar(32)
  legalName          String                 @map("legal_name") @db.VarChar(200)
  displayName        String                 @map("display_name") @db.VarChar(200)
  taxIdentifierHash  String?                @map("tax_identifier_hash") @db.Char(64)
  verificationStatus VerificationStatus     @default(PENDING) @map("verification_status")
  status             RecordStatus           @default(DRAFT)
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  products           Product[]
  batches            InventoryBatch[]
  verifications      SupplierVerification[]

  @@index([verificationStatus, status])
  @@map("suppliers")
}

model Processor {
  id                 String             @id @default(uuid()) @db.Uuid
  code               String             @unique @db.VarChar(32)
  name               String             @db.VarChar(200)
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  status             RecordStatus       @default(DRAFT)
  facilities         Facility[]
  products           Product[]
  batches            InventoryBatch[]

  @@map("processors")
}

model SourceLocation {
  id                 String             @id @default(uuid()) @db.Uuid
  parentId           String?            @map("parent_id") @db.Uuid
  code               String             @unique @db.VarChar(48)
  nameBn             String             @map("name_bn") @db.VarChar(180)
  nameEn             String             @map("name_en") @db.VarChar(180)
  countryCode        String             @default("BD") @map("country_code") @db.Char(2)
  division           String?            @db.VarChar(120)
  district           String?            @db.VarChar(120)
  upazila            String?            @db.VarChar(120)
  latitude           Decimal?           @db.Decimal(9, 6)
  longitude          Decimal?           @db.Decimal(9, 6)
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  parent             SourceLocation?    @relation("LocationTree", fields: [parentId], references: [id], onDelete: SetNull)
  children           SourceLocation[]   @relation("LocationTree")
  facilities         Facility[]
  productSources     ProductSource[]
  batches            InventoryBatch[]
  warehouses         Warehouse[]

  @@index([division, district, upazila])
  @@map("source_locations")
}

model Facility {
  id                 String             @id @default(uuid()) @db.Uuid
  processorId        String             @map("processor_id") @db.Uuid
  sourceLocationId   String             @map("source_location_id") @db.Uuid
  code               String             @unique @db.VarChar(40)
  name               String             @db.VarChar(200)
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  processor          Processor          @relation(fields: [processorId], references: [id], onDelete: Restrict)
  sourceLocation     SourceLocation     @relation(fields: [sourceLocationId], references: [id], onDelete: Restrict)
  batches            InventoryBatch[]

  @@index([processorId, verificationStatus])
  @@map("facilities")
}

model EvidenceDocument {
  id                    String                 @id @default(uuid()) @db.Uuid
  kind                  EvidenceKind
  storageKey            String                 @unique @map("storage_key") @db.VarChar(500)
  sha256                String                 @db.Char(64)
  mimeType              String                 @map("mime_type") @db.VarChar(120)
  issuedBy              String?                @map("issued_by") @db.VarChar(255)
  issuedAt              DateTime?              @map("issued_at") @db.Timestamptz(6)
  expiresAt             DateTime?              @map("expires_at") @db.Timestamptz(6)
  verificationStatus    VerificationStatus     @default(PENDING) @map("verification_status")
  containsSensitiveData Boolean                @default(false) @map("contains_sensitive_data")
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  supplierVerifications SupplierVerification[]
  claimEvidence         ClaimEvidence[]
  productSources        ProductSource[]
  certifications        Certification[]
  labReports            LabReport[]

  @@index([kind, verificationStatus, expiresAt])
  @@map("evidence_documents")
}

model SupplierVerification {
  id                 String             @id @default(uuid()) @db.Uuid
  supplierId         String             @map("supplier_id") @db.Uuid
  evidenceDocumentId String?            @map("evidence_document_id") @db.Uuid
  status             VerificationStatus @default(PENDING)
  reviewNotes        String?            @map("review_notes")
  reviewedById       String?            @map("reviewed_by_id") @db.Uuid
  reviewedAt         DateTime?          @map("reviewed_at") @db.Timestamptz(6)
  validFrom          DateTime?          @map("valid_from") @db.Timestamptz(6)
  validUntil         DateTime?          @map("valid_until") @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  supplier           Supplier           @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  evidenceDocument   EvidenceDocument?  @relation(fields: [evidenceDocumentId], references: [id], onDelete: SetNull)
  reviewedBy         User?              @relation("SupplierVerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([supplierId, status, validUntil])
  @@map("supplier_verifications")
}

model Product {
  id                   String                 @id @default(uuid()) @db.Uuid
  categoryId           String                 @map("category_id") @db.Uuid
  producerId           String?                @map("producer_id") @db.Uuid
  supplierId           String?                @map("supplier_id") @db.Uuid
  processorId          String?                @map("processor_id") @db.Uuid
  slug                 String                 @unique @db.VarChar(180)
  productCode          String                 @unique @map("product_code") @db.VarChar(40)
  nameBn               String                 @map("name_bn") @db.VarChar(200)
  nameEn               String                 @map("name_en") @db.VarChar(200)
  shortDescriptionBn   String?                @map("short_description_bn")
  shortDescriptionEn   String?                @map("short_description_en")
  descriptionBn        String?                @map("description_bn")
  descriptionEn        String?                @map("description_en")
  storageInstructions  String?                @map("storage_instructions")
  shelfLifeDays        Int?                   @map("shelf_life_days")
  status               RecordStatus           @default(DRAFT)
  publishApproved      Boolean                @default(false) @map("publish_approved")
  featured             Boolean                @default(false)
  subscriptionEligible Boolean                @default(false) @map("subscription_eligible")
  seoTitle             String?                @map("seo_title") @db.VarChar(255)
  seoDescription       String?                @map("seo_description") @db.VarChar(320)
  seoKeywords          String[]               @default([]) @map("seo_keywords")
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  category             Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  producer             Producer?              @relation(fields: [producerId], references: [id], onDelete: SetNull)
  supplier             Supplier?              @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  processor            Processor?             @relation(fields: [processorId], references: [id], onDelete: SetNull)
  variants             ProductVariant[]
  ingredients          ProductIngredient[]
  attributes           ProductAttribute[]
  media                ProductMedia[]
  sources              ProductSource[]
  claims               ProductClaim[]
  certifications       ProductCertification[]
  reviews              ProductReview[]
  questions            ProductQuestion[]
  bundleItems          BundleItem[]
  promotionProducts    PromotionProduct[]
  wishlistItems        WishlistItem[]
  analyticsEvents      AnalyticsEvent[]
  dailyMetrics         DailyProductMetric[]
  recommendations      Recommendation[]
  forecasts            SalesForecast[]

  @@index([categoryId, status, featured])
  @@index([producerId, supplierId])
  @@map("products")
}

model ProductVariant {
  id                String              @id @default(uuid()) @db.Uuid
  productId         String              @map("product_id") @db.Uuid
  sku               String              @unique @db.VarChar(64)
  barcode           String?             @unique @db.VarChar(64)
  label             String              @db.VarChar(120)
  unit              String              @db.VarChar(20)
  netQuantity       Decimal             @map("net_quantity") @db.Decimal(12, 3)
  taxRate           Decimal             @default(0) @map("tax_rate") @db.Decimal(6, 5)
  lowStockThreshold Decimal             @default(0) @map("low_stock_threshold") @db.Decimal(18, 3)
  reorderPoint      Decimal             @default(0) @map("reorder_point") @db.Decimal(18, 3)
  reorderQuantity   Decimal             @default(0) @map("reorder_quantity") @db.Decimal(18, 3)
  status            RecordStatus        @default(DRAFT)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  product           Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  prices            ProductPrice[]
  batches           InventoryBatch[]
  inventoryLevels   InventoryLevel[]
  movements         InventoryMovement[]
  reservations      StockReservation[]
  cartItems         CartItem[]
  orderItems        OrderItem[]
  bundleItems       BundleItem[]
  analyticsEvents   AnalyticsEvent[]
  recommendations   Recommendation[]

  @@index([productId, status])
  @@map("product_variants")
}

model ProductPrice {
  id                   String         @id @default(uuid()) @db.Uuid
  variantId            String         @map("variant_id") @db.Uuid
  promotionId          String?        @map("promotion_id") @db.Uuid
  type                 PriceType
  currency             String         @default("BDT") @db.Char(3)
  amountMinor          BigInt         @map("amount_minor")
  compareAtAmountMinor BigInt?        @map("compare_at_amount_minor")
  costAmountMinor      BigInt?        @map("cost_amount_minor")
  validFrom            DateTime       @default(now()) @map("valid_from") @db.Timestamptz(6)
  validUntil           DateTime?      @map("valid_until") @db.Timestamptz(6)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  variant              ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  promotion            Promotion?     @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  @@index([variantId, type, validFrom, validUntil])
  @@map("product_prices")
}

model ProductIngredient {
  productId  String  @map("product_id") @db.Uuid
  name       String  @db.VarChar(200)
